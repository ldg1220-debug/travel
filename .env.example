# Google Maps JavaScript API key (client-exposed). Without this, screens
# using src/components/map/MapProvider.tsx (provider="google") show a
# clean "not configured" state instead of a live map. Must have the
# Places API (New) enabled too — /planner's search box
# (src/app/(app)/planner/PlacesSearchInput.tsx) uses the same key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Kakao Maps JS SDK key (client-exposed, a "JavaScript key" from the Kakao
# Developers console, not the REST key below). Same graceful-degradation
# behavior as the Google key, via src/components/map/MapProvider.tsx
# (provider="kakao").
NEXT_PUBLIC_KAKAO_MAP_KEY=

# Kakao Local REST API key (server-only) used by
# src/app/api/places/search/route.ts for domestic keyword search. A
# different key type than NEXT_PUBLIC_KAKAO_MAP_KEY above — the Kakao
# Developers console issues separate JavaScript and REST keys per app.
KAKAO_REST_API_KEY=

# Kakao JS SDK key (client-exposed, a THIRD distinct Kakao key type from the
# two above) used only to send "카카오톡 공유" (KakaoTalk share) messages via
# src/lib/kakaoShare.ts — Kakao Developers console > 내 애플리케이션 > 앱 키 >
# JavaScript 키. Also requires the app's 플랫폼 설정 > Web to list this site's
# domain, and 카카오 로그인 아님 — this key has nothing to do with AUTH_KAKAO_ID
# below, it only powers the share button.
NEXT_PUBLIC_KAKAO_JS_KEY=

# Google Places API (New) key used by the data pipeline (src/server/pipeline)
# and by src/app/api/places/search/route.ts for international keyword
# search. Without this, both resolve against offline fixtures instead.
GOOGLE_PLACES_API_KEY=

# Optional: Anthropic API key. Powers two features when set, both of which
# degrade gracefully without it:
#  - the pipeline's review-authenticity check (src/server/pipeline/llmVerifier.ts)
#    → falls back to a conservative heuristic
#  - "AI 추천 동선" course curation (src/lib/server/courseLlm.ts) → falls back
#    to a deterministic rating×review + proximity ranker
LLM_API_KEY=

# --- 숙소 예약 제휴 링크 (수익구조, src/lib/affiliates.ts) ---
# 숙소 검색 결과 카드의 "최저가 예약" 버튼이 이 id로 제휴 딥링크를 만든다.
# 비워두면 버튼은 그냥 일반 검색 링크로 동작하고 "제휴" 표기도 뜨지 않으므로,
# 프로그램 승인 전에도 안전하게 배포할 수 있다. id를 채우는 순간 수익화 활성화.
# NEXT_PUBLIC_* 인 이유: 링크를 브라우저에서 조립하기 때문 (비밀 키 아님, 공개 파트너 코드).
# ⚠️ 정확한 파라미터명/URL 규격은 각 프로그램 대시보드에서 최종 확인 필요.
NEXT_PUBLIC_AGODA_CID=
NEXT_PUBLIC_TRIP_ALLIANCE_ID=
NEXT_PUBLIC_TRIP_SID=
NEXT_PUBLIC_HOTELS_AFFILIATE=
NEXT_PUBLIC_YANOLJA_PARTNER=
NEXT_PUBLIC_YEOGI_PARTNER=

# --- Auth & DB (Phase 1.5) ---

# Postgres connection string, e.g. postgresql://user:pass@host:5432/travel
# Run `npm run db:migrate` after setting this to create the schema
# (src/server/db/schema.sql).
DATABASE_URL=

# Required in production. Generate with: npx auth secret
AUTH_SECRET=

# Social login providers (Auth.js v5 env-var inference — a provider is
# only registered once its *_ID is set, see src/auth.ts). Callback URL for
# each is /api/auth/callback/<provider>.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# --- 회원 탈퇴 확인 메일 + 유예기간(src/lib/server/accountDeletion.ts) ---

# Resend API key — 탈퇴 확인 메일 발송에 쓴다(src/lib/server/mail.ts).
# resend.com에서 발급. 비워두면 탈퇴 요청(POST /api/account/deletion-request)이
# "이메일 발송이 설정되지 않았어요" 에러로 실패한다(가짜로 성공 처리하지 않음).
RESEND_API_KEY=

# 확인 메일의 발신자 표시. Resend에 도메인을 아직 검증하지 않았다면 비워둬도
# 되는 기본값(onboarding@resend.dev)이 쓰이지만, 이 기본 발신자는 Resend
# 계정 소유자 본인 이메일로만 발송이 가능하다 — 실제 사용자에게 보내려면
# 자체 도메인을 Resend에 검증 등록한 뒤 그 도메인 주소로 채워야 한다.
RESEND_FROM_EMAIL=

# Vercel Cron(vercel.json)이 매일 /api/cron/purge-deleted-accounts를 호출할 때
# Authorization: Bearer 헤더로 실어 보내는 값과 일치해야 한다 — 설정하지
# 않으면 그 크론 라우트는 항상 500을 돌려주며 아무것도 삭제하지 않는다
# (파괴적인 작업이라 시크릿 없이 열어주는 대신 안전하게 막는 쪽을 택함).
CRON_SECRET=

# main에 push(≈배포)될 때마다 GitHub Actions(.github/workflows/ci.yml의
# announce job)가 POST /api/cron/announce-update를 호출할 때 Authorization:
# Bearer 헤더로 실어 보내는 값과 일치해야 한다. 아래 두 곳에 "같은 값"을
# 넣어야 동작한다:
#  1. 이 앱의 Vercel 프로젝트 환경변수(Production)에 DEPLOY_ANNOUNCE_SECRET
#  2. GitHub 레포 Settings > Secrets and variables > Actions에 같은 이름의
#     레포 시크릿
# 설정하지 않으면 announce job은 인증 실패로 조용히 스킵된다(빌드는 막지
# 않음). 요약에 쓰이는 LLM_API_KEY도 함께 설정돼 있어야 실제로 공지가
# 만들어진다 — 없으면 이 라우트는 항상 notified:false를 반환한다.
DEPLOY_ANNOUNCE_SECRET=
